<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generator Fake Obywatela</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --accent-color: #38bdf8;
            --accent-hover: #0ea5e9;
            --border-color: #334155;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
        }

        .container {
            width: 100%;
            max-width: 500px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.3rem;
            color: var(--accent-color);
        }

        .profile-card {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
        }

        .label {
            font-weight: 600;
            color: #94a3b8;
        }

        .value {
            text-align: right;
            font-weight: 500;
        }

        button {
            margin-top: 20px;
            width: 100%;
            background-color: var(--accent-color);
            color: #0f172a;
            border: none;
            padding: 12px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
        }

        button:active {
            background-color: var(--accent-hover);
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Generator Fake Obywatela</h1>
        <div class="profile-card" id="profile"></div>
        <button onclick="generateCitizen()">Wylosuj nowego obywatela</button>
    </div>

    <script>
        const imionaM = ["Jan", "Piotr", "Krzysztof", "Andrzej", "Tomasz", "Paweł", "Michał", "Marcin", "Jakub", "Kacper", "Mateusz", "Bartosz"];
        const imionaK = ["Anna", "Maria", "Katarzyna", "Małgorzata", "Agnieszka", "Krystyna", "Barbara", "Ewa", "Magdalena", "Julia", "Maja", "Zuzanna"];

        const nazwiskaM = ["Nowak", "Kowalski", "Wiśniewski", "Wójcik", "Kowalczyk", "Kamiński", "Lewandowski", "Zieliński", "Szymański", "Woźniak"];
        const nazwiskaK = ["Nowak", "Kowalska", "Wiśniewska", "Wójcik", "Kowalczyk", "Kamińska", "Lewandowska", "Zielińska", "Szymańska", "Woźniak"];

        const miasta = [
            { miasto: "Warszawa", woj: "Mazowieckie", kod: "00-001" },
            { miasto: "Kraków", woj: "Małopolskie", kod: "30-002" },
            { miasto: "Gliwice", woj: "Śląskie", kod: "44-100" },
            { miasto: "Wrocław", woj: "Dolnośląskie", kod: "50-106" },
            { miasto: "Poznań", woj: "Wielkopolskie", kod: "61-701" },
            { miasto: "Gdańsk", woj: "Pomorskie", kod: "80-838" }
        ];

        const ulice = ["Kwiatowa", "Leśna", "Słoneczna", "Krótka", "Polna", "Mickiewicza", "Lipowa", "Brzozowa", "Łąkowa", "Ogrodowa"];

        function randChoice(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function generatePesel(ptec, rok, miesiac, dzien) {
            let r = rok.toString().slice(-2);
            let m = miesiac < 10 ? '0' + miesiac : miesiac;
            let d = dzien < 10 ? '0' + dzien : dzien;
            
            if (rok >= 2000) m = parseInt(m) + 20;

            let seryjny = randInt(100, 999);
            let p = ptec === 'M' ? randInt(1, 9) * 2 : randInt(0, 4) * 2 + 1;
            let p_str = seryjny.toString() + p;

            let base = r + m + d + p_str;
            let weights = [1, 3, 7, 9, 1, 3, 7, 9, 1, 3];
            let sum = 0;
            for (let i = 0; i < 10; i++) {
                sum += parseInt(base[i]) * weights[i];
            }
            let checksum = (10 - (sum % 10)) % 10;

            return base + checksum;
        }

        function generateCitizen() {
            const ptec = Math.random() > 0.5 ? 'M' : 'K';
            const imie = ptec === 'M' ? randChoice(imionaM) : randChoice(imionaK);
            const nazwisko = ptec === 'M' ? randChoice(nazwiskaM) : randChoice(nazwiskaK);
            
            const rok = randInt(1970, 2005);
            const miesiac = randInt(1, 12);
            const dzien = randInt(1, 28);
            const dataUrodzenia = `${dzien < 10 ? '0'+dzien : dzien}.${miesiac < 10 ? '0'+miesiac : miesiac}.${rok}`;

            const lokalizacja = randChoice(miasta);
            const ulica = randChoice(ulice);
            const nrDomu = randInt(1, 120);
            const nrMieszkania = Math.random() > 0.4 ? `/${randInt(1, 50)}` : '';

            const pesel = generatePesel(ptec, rok, miesiac, dzien);
            const nip = randInt(100, 999) + "-" + randInt(100, 999) + "-" + randInt(10, 99) + "-" + randInt(10, 99);
            const telefon = "+48 " + randInt(500, 899) + " " + randInt(100, 999) + " " + randInt(100, 999);

            const html = `
                <div class="data-row"><span class="label">Imię i nazwisko:</span><span class="value">${imie} ${nazwisko}</span></div>
                <div class="data-row"><span class="label">Płeć:</span><span class="value">${ptec === 'M' ? 'Mężczyzna' : 'Kobieta'}</span></div>
                <div class="data-row"><span class="label">Data urodzenia:</span><span class="value">${dataUrodzenia}</span></div>
                <div class="data-row"><span class="label">PESEL:</span><span class="value">${pesel}</span></div>
                <div class="data-row"><span class="label">NIP:</span><span class="value">${nip}</span></div>
                <div class="data-row"><span class="label">Adres:</span><span class="value">ul. ${ulica} ${nrDomu}${nrMieszkania}</span></div>
                <div class="data-row"><span class="label">Miasto:</span><span class="value">${lokalizacja.kod} ${lokalizacja.miasto}</span></div>
                <div class="data-row"><span class="label">Województwo:</span><span class="value">${lokalizacja.woj}</span></div>
                <div class="data-row"><span class="label">Telefon:</span><span class="value">${telefon}</span></div>
            `;

            document.getElementById('profile').innerHTML = html;
        }

        generateCitizen();
    </script>
</body>
</html>
